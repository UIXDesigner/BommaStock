# Bommastock environment template
# Copy to `.env` in this directory. Never commit `.env`.
# Phase 1 only requires DATABASE_URL for Prisma migrate/seed.
# Leave other values empty until later phases. Do not invent secrets.

# --- Database (required for migrate / seed / studio) ---
DATABASE_URL=

# --- Auth (Phase 2+) ---
AUTH_SECRET=
AUTH_URL=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Emergency only. Default false. See DECISIONS.md D029.
ADMIN_BOOTSTRAP_ALLOW_ADDITIONAL=false

# Storefront social login (optional). Leave empty until you create provider apps.
# Callbacks: {STOREFRONT_URL}/api/auth/callback/{google|microsoft-entra-id|apple}
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
# Optional tenant. Unset = any Microsoft/Outlook account (common).
AUTH_MICROSOFT_TENANT_ID=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- App URLs ---
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Email (Phase 2+) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Cloudflare R2 (Phase 3+) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# --- Payments (later phase) ---
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Jobs (later phase) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Tax seed (optional). Do not invent a production GST rate.
# If unset, seed inserts an INACTIVE GST row (rateBps 0).
# If set, seed may activate that rateBps when no ACTIVE TaxRate exists.
TAX_RATE_BPS=
